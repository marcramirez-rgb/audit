# Real credentials -- never commit. Use .env.example as the template.
.env
access.env
*.env
!.env.example

__pycache__/
*.pyc

# Per-machine virtual environment -- never commit. Each user builds their own
# via setup.bat; committing it would ship one machine's absolute paths to others.
.venv/

# Generated reports shouldn't be committed either
Camera_Reports_Master/

# Skill-evaluation/benchmark scratch data, not project source
.claude/skills/camera-audit-workspace/

# Real fleet/client data exports -- never commit (client names, site addresses,
# live-unit serials, camera IPs). Build these locally from Snowflake as needed.
*.csv

# Live-camera test/debug image outputs -- may contain real client scene imagery
thermal_overlay_test.jpg
thermal_test_output.jpg
replay_hikviz_zone_*.jpg
debug_overlay_tests/

# Packet captures
*.pcapng
*.pcap

# AOA writer artifacts -- live camera config dumps + backups (real fleet IPs and
# analytics config). Generated locally by probe_aoa.py / analytics_writer_gui.py, never commit.
aoa_probes/
aoa_backups/
hik_probes/
hik_backups/
hik_push_debug/

# PTZ drift audit reports (ptz_tester.py output -- real fleet IPs + scene imagery)
PTZ_*.xlsx

# ML zone-suggestion experiment data -- real fleet snapshots, never commit
ai_suggest_jobs/
