# Copy this file to ".env" and fill in real values -- never commit or share
# the real ".env" file, it contains live camera credentials.
#
# NOTE: as of now, neither the GUI (audit_gui.py) nor the CLI (combined.py)
# actually use these values -- both always prompt for credentials fresh on
# every run (a deliberate fix to stop stale/wrong .env values from silently
# skipping a prompt). This file currently has no effect; it's kept only as a
# placeholder in case that's revisited later. Leave it blank or delete it.

# --- Axis Camera Credentials ---
AXIS_USER=
AXIS_PASSWORD=

# --- Hikvision Camera Credentials ---
HIK_USER=
HIK_PASSWORD=

# --- Snowflake (Fleet Picker, v2.0) ---
# Powers the "Fleet Picker" tab (Client -> Location -> TDC) in audit_gui.py and
# analytics_writer_gui.py. Auth is SSO / externalbrowser: on the first query the
# connector opens your browser for the LVT (Okta) login, so NO password/key is
# stored here. Only ACCOUNT and USER are required; the rest are optional.
#
# ACCOUNT must be the org-account identifier "BWXPHOE-LVT" -- NOT the account
# locator (MZA23640...). The locator URL returns 404 on the auth endpoint.
# Find it in Snowflake with:
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
#
# If snowflake-connector-python isn't installed or these are blank, the picker
# falls back to the offline cache (FLEET_CATALOG_PATH / fleet_catalog.csv).
SNOWFLAKE_ACCOUNT=BWXPHOE-LVT
SNOWFLAKE_USER=you@lvt.com
SNOWFLAKE_WAREHOUSE=PRODUCT_WH
SNOWFLAKE_ROLE=APP-SNOWFLAKE-PRODUCT_ANALYST

# Offline fallback: path to an exported fleet catalog CSV with columns
# CLIENT_NM, LOCATION_NM, LIVE_UNIT_SERIAL_NM, IP, MANUFACTURER, MODEL.
# Defaults to fleet_catalog.csv next to the app. See fleet_catalog.sample.csv.
FLEET_CATALOG_PATH=
