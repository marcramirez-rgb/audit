# Copy this file to ".env" and fill in real values -- never commit or share
# the real ".env" file, it contains live camera credentials.
#
# NOTE: as of now, neither the GUI (audit_gui.py) nor the CLI (combined.py)
# actually use these values -- both always prompt for credentials fresh on
# every run (a deliberate fix to stop stale/wrong .env values from silently
# skipping a prompt). This file currently has no effect; it's kept only as a
# placeholder in case that's revisited later. Leave it blank or delete it.

# --- Axis Camera Credentials ---
AXIS_USER=
AXIS_PASSWORD=

# --- Hikvision Camera Credentials ---
HIK_USER=
HIK_PASSWORD=

# --- Snowflake (Fleet Picker) -- OPTIONAL, usually leave BLANK ---
# The Fleet Picker (Client -> Location -> TDC) works with NO setup here: LVT's
# account/warehouse/role are baked into fleet_catalog.py and your login is
# auto-detected from your Windows (Entra) account. Auth is SSO/externalbrowser --
# the first query opens your browser for the LVT (Okta) login; no key is stored.
#
# ONLY set these to OVERRIDE the auto-detect (e.g. auto-detect picked the wrong
# email, or you're on a machine that isn't Entra-joined). Leaving them blank is
# the normal case -- do NOT fill in a placeholder, a wrong value here overrides
# the correct auto-detected one.
#   ACCOUNT, if ever set, must be the org-account "BWXPHOE-LVT" (NOT the MZA...
#   locator, which 404s on the auth endpoint).
#SNOWFLAKE_ACCOUNT=
#SNOWFLAKE_USER=
#SNOWFLAKE_WAREHOUSE=
#SNOWFLAKE_ROLE=

# Offline fallback: path to an exported fleet catalog CSV with columns
# CLIENT_NM, LOCATION_NM, LIVE_UNIT_SERIAL_NM, IP, MANUFACTURER, MODEL.
# Defaults to fleet_catalog.csv next to the app. See fleet_catalog.sample.csv.
FLEET_CATALOG_PATH=
